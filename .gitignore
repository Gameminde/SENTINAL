# Keep this repository focused on Sentinel source and Agent Lab artifacts.
# Everything else in the local workspace is ignored by default.
*

!.gitignore
!.gitattributes
!README.md
!sentinel-control/
!sentinel-control/**
!agent-lab/
!agent-lab/**
!archive/
!archive/**
!PLAN/
!PLAN/**

# Secrets and environment files
**/.env
**/.env.*
!**/.env.example

# Dependency and build outputs
**/node_modules/
**/.next/
**/dist/
**/build/
**/.turbo/
**/*.tsbuildinfo

# Python local state
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.venv/
**/venv/

# Sentinel generated/local runtime state
sentinel-control/data/generated_projects/
sentinel-control/data/traces/
sentinel-control/data/evidence_cache/
sentinel-control/data/memory/
sentinel-control/data/mission_state.json
sentinel-control/data/web_state.json
sentinel-control/services/sentinel-core/data/generated_projects/
sentinel-control/services/sentinel-core/w/

# Agent Lab vendor source clones are research inputs, not repo-owned source.
agent-lab/vendors/*/source/

# Archived prototype local state and nested repository metadata
archive/prototypes/*/.git/
archive/prototypes/*/.gitnexus/
archive/prototypes/*/.claude/
archive/prototypes/*/AGENTS.md
archive/prototypes/*/CLAUDE.md
archive/prototypes/*/**/.env
archive/prototypes/*/**/.env.*
!archive/prototypes/*/**/.env.example
archive/prototypes/*/**/node_modules/
archive/prototypes/*/**/.next/
archive/prototypes/*/**/__pycache__/
archive/prototypes/*/**/.pytest_cache/
archive/prototypes/*/**/.venv/
archive/prototypes/*/**/dist/
archive/prototypes/*/**/output/
archive/prototypes/*/**/*.pyc
archive/prototypes/*/engine/data/working_proxies.json
archive/prototypes/*/engine/data/working_proxies.txt

# Logs and local reports
**/*.log
*.log

# Local benchmark scratch outputs. Keep benchmark source and reports tracked.
agent-lab/benchmarks/browser_tasks/tmp_*/
